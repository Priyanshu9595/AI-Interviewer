# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# PostgreSQL. Neon, Supabase, RDS or a local instance all work.
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# Use long random values in production. `openssl rand -hex 32` is fine.
JWT_SECRET=change_me_to_a_long_random_string
JWT_REFRESH_SECRET=change_me_to_a_different_long_random_string

# One of these. Whichever key is set is the one used; with both, LLM_PROVIDER
# decides. https://console.mistral.ai  /  https://console.groq.com
MISTRAL_API_KEY=
GROQ_API_KEY=

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------

PORT=5000
NODE_ENV=development

# Public origins. APP_URL is what candidates receive in their invitation emails,
# so it must be reachable from outside your network in production.
APP_URL=http://localhost:3000
API_URL=http://localhost:5000

# ---------------------------------------------------------------------------
# Models
# ---------------------------------------------------------------------------

# auto  — use Mistral if its key is set, otherwise Groq.
# mistral / groq — name one explicitly, for when both keys are present.
LLM_PROVIDER=auto

# Fast: every conversational turn, where the candidate is waiting.
# Smart: question generation and scoring, where quality outweighs speed.
MISTRAL_FAST_MODEL=mistral-small-latest
MISTRAL_SMART_MODEL=mistral-large-latest

GROQ_FAST_MODEL=openai/gpt-oss-20b
GROQ_SMART_MODEL=openai/gpt-oss-120b

# ---------------------------------------------------------------------------
# Email (Brevo transactional API)
# Without a key, emails are printed to the console instead of being sent — the
# full scheduling path still runs, so local development is unaffected.
# ---------------------------------------------------------------------------

API_KEY_FOR_EMAIL=
EMAIL_FROM=no-reply@yourdomain.com
EMAIL_FROM_NAME=AI Interview Platform

# Redis, for signup one-time codes. Required for sign-up to work.
# Upstash free tier: create a database at https://console.upstash.com/redis
# and copy its rediss:// URL here. Works from localhost and from Fly.
REDIS_URL=

# ---------------------------------------------------------------------------
# Meeting providers (all optional)
# Any provider left unconfigured falls back to the built-in interview room,
# which is the only one where the AI can actually speak with the candidate.
# ---------------------------------------------------------------------------

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=

MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_ORGANIZER_ID=

# ---------------------------------------------------------------------------
# Scheduler
# Set SCHEDULER_ENABLED=false on every replica but one, or candidates receive
# duplicate reminder emails.
# ---------------------------------------------------------------------------

SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_MS=60000
NO_SHOW_GRACE_MINUTES=5

# ---------------------------------------------------------------------------
# Code execution
# The sandbox blocks process, network and filesystem APIs and caps wall clock,
# but it is not a hardened boundary. For untrusted candidates, run the backend
# in a locked-down container or set CODE_EXEC_ENABLED=false.
# ---------------------------------------------------------------------------

CODE_EXEC_ENABLED=true
CODE_EXEC_TIMEOUT_MS=5000

# ---------------------------------------------------------------------------
# Deepgram speech-to-text.
# Candidate audio is proxied through this server, so the key is never exposed
# to the browser. Without it, the browser's own speech recognition is used,
# which only works in Chrome and Edge.
#
# Required for the Google Meet bot: there is no browser to fall back to.
# ---------------------------------------------------------------------------

DEEPGRAM_API_KEY=

# ---------------------------------------------------------------------------
# Meeting bot
#
# Joins a Google Meet, Zoom or Microsoft Teams link the recruiter already
# created and runs the interview inside it.
#
# No API keys are needed for any of the three — the bot drives a browser, not
# an API. Google Meet needs a signed-in bot account; Zoom and Teams join as
# named guests.
#
# Full setup: docs/MEETING_BOT.md   Every variable: docs/ENVIRONMENT.md
# ---------------------------------------------------------------------------

MEET_BOT_ENABLED=true

# Chromium profile holding the bot accounts' sessions, shared by all three
# platforms. Sign in once with `npm run bot:login` (add `-- zoom` or
# `-- teams` for those). Never put an account password in this file.
GOOGLE_BOT_PROFILE_PATH=./.meet-bot-profile

# Real Chrome handles all three meeting clients better than bundled Chromium.
# Use `chromium` if you do not have Chrome installed.
MEET_BOT_BROWSER_CHANNEL=chrome

# Meeting clients are far more reliable in a visible window. Turn this on only
# after the join flow is working for you.
MEET_BOT_HEADLESS=false

MEET_BOT_DISPLAY_NAME=AI Interviewer

# How many minutes before the scheduled time the bot opens the meeting.
# 0 means it joins at the scheduled time itself: a 3:00 pm interview is joined
# at 3:00 pm. Raise it to have the bot admitted and settled before the candidate
# arrives, at the cost of it sitting in an empty meeting.
MEET_BOT_JOIN_LEAD_MINUTES=0

# How long to sit in the lobby waiting to be admitted by the organiser.
MEET_BOT_ADMISSION_TIMEOUT_MS=600000

# How long to wait for a candidate who has not arrived, counted from the
# scheduled start rather than from when the bot joined.
#
# Two phases, because "five minutes late" and "not coming" are different things.
# A 3:00 pm interview waits until 3:05; if nobody is there it waits a final
# 3:05-3:07 and then cancels, marking the candidate absent. A candidate who
# arrives at any point in either window is admitted and the interview starts.
MEET_BOT_CANDIDATE_WAIT_MINUTES=5
MEET_BOT_CANDIDATE_GRACE_MINUTES=2

# Concurrent meetings per process. Each one is a real browser.
MEET_BOT_MAX_CONCURRENT=2

# How the AI's voice gets into the meeting.
#   deepgram  — synthesised server-side and injected into the bot's synthetic
#               microphone. No operating-system setup at all.
#   webspeech — the browser's SpeechSynthesis API. Free, but it plays to a
#               sound device rather than returning samples, so it needs a
#               virtual audio cable (VB-CABLE on Windows).
MEET_BOT_TTS=deepgram
MEET_BOT_TTS_MODEL=aura-2-thalia-en
MEET_BOT_TTS_RATE=1

# Where the coding-exercise link is delivered.
#
# The interviewer posts it into the meeting chat when the round starts. Set
# this to true to also send it with the invitation email, as a safety net for
# meetings whose chat the candidate cannot reach.
MEET_BOT_CODING_LINK_IN_EMAIL=false

# Share a live view of the candidate's editor onto the meeting screen.
#
# Off by default. Meet shares a tab's audio along with its picture, and the
# share picker is steered by a command-line title match rather than clicked —
# so when that match misses, the bot shares the meeting back into itself and
# the call fills with feedback. The coding round works without it.
MEET_BOT_SHARE_CODE_SCREEN=false
